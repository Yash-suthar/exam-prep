generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum ItemType {
  BOOK
  MATERIAL
  PAPER
  PLAN
  EXAM
  NOTICE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

enum EducationLevel {
  STUDENT
  GRADUATE
  POST_GRADUATE
  WORKING_PROFESSIONAL
}

enum GoalType {
  SCHOOL
  COMPETITIVE_EXAM
}

enum DayStatus {
  COMPLETE
  PARTIAL
  NONE
  MISSED_EXAM
}

enum AccessModel {
  PAID
  FREE
  FREE_TRIAL
}

enum TopicStatus {
  NOT_STARTED
  LEARNING
  REVISING
  MASTERED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String?
  role         Role          @default(USER)
  suspended    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  accessGrants AccessGrant[]
  purchases    Purchase[]
  examAttempts ExamAttempt[]
  auditLogs    AuditLog[]    @relation("AuditActor")
  profile      UserProfile?
  settings     UserSettings?
  goals        Goal[]
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model UserProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationLevel  EducationLevel
  standard        String?
  examGoals       String[]
  onboardedAt     DateTime?
}

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  confirmBeforeLocking Boolean @default(true)
  theme                String  @default("system")
}

model Goal {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               GoalType
  examTag            String?
  targetPercent      Float?
  targetDate         DateTime?
  targetRank         Int?
  isActive           Boolean         @default(true)
  dailyMinutesTarget Int             @default(60)
  weeklyMockTarget   Int             @default(3)
  restDays           Int[]
  archivedAt         DateTime?
  createdAt          DateTime        @default(now())
  tasks              GoalTask[]
  dailyLogs          DailyLog[]
  milestones         GoalMilestone[]
  topics             SyllabusTopic[]
  sessions           StudySession[]
}

model GoalMilestone {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  isDone      Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model SyllabusTopic {
  id            String         @id @default(cuid())
  goalId        String
  goal          Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  subject       String
  name          String
  status        TopicStatus    @default(NOT_STARTED)
  confidence    Int            @default(0)
  lastRevisedAt DateTime?
  createdAt     DateTime       @default(now())
  sessions      StudySession[]

  @@unique([goalId, subject, name])
}

model StudySession {
  id        String         @id @default(cuid())
  goalId    String
  goal      Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  topicId   String?
  topic     SyllabusTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  minutes   Int
  note      String?
  createdAt DateTime       @default(now())

  @@index([goalId, createdAt])
}

model GoalTask {
  id            String  @id @default(cuid())
  goalId        String
  goal          Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  label         String
  isAutoTracked Boolean @default(false)
  targetMinutes Int?
}

model DailyLog {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date        DateTime
  status      DayStatus
  taskResults Json
  minutes     Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([goalId, date])
}

model Subject {
  id     String  @id @default(cuid())
  name   String  @unique
  books  Book[]
  papers Paper[]
  exams  Exam[]
}

model Book {
  id                     String           @id @default(cuid())
  title                  String
  subjectId              String
  subject                Subject          @relation(fields: [subjectId], references: [id])
  fileUrl                String
  price                  Float
  isFree                 Boolean          @default(false)
  coverImage             String?
  createdAt              DateTime         @default(now())
  targetEducationLevels  EducationLevel[]
  targetStandards        String[]
  targetExamGoals        String[]
  accessModel            AccessModel      @default(PAID)
  trialDurationDays      Int?
}

model StudyMaterial {
  id                     String           @id @default(cuid())
  title                  String
  fileUrl                String
  price                  Float
  isFree                 Boolean          @default(false)
  tags                   String[]
  createdAt              DateTime         @default(now())
  targetEducationLevels  EducationLevel[]
  targetStandards        String[]
  targetExamGoals        String[]
  accessModel            AccessModel      @default(PAID)
  trialDurationDays      Int?
}

model Paper {
  id                     String           @id @default(cuid())
  title                  String
  subjectId              String
  subject                Subject          @relation(fields: [subjectId], references: [id])
  year                   Int?
  fileUrl                String
  price                  Float
  isFree                 Boolean          @default(false)
  targetEducationLevels  EducationLevel[]
  targetStandards        String[]
  targetExamGoals        String[]
  accessModel            AccessModel      @default(PAID)
  trialDurationDays      Int?
}

model Notice {
  id                     String           @id @default(cuid())
  title                  String
  description            String
  examDate               DateTime?
  applyLink              String
  isPinned               Boolean          @default(false)
  createdAt              DateTime         @default(now())
  attachments            String[]
  visibleFrom            DateTime?
  visibleUntil           DateTime?
  targetEducationLevels  EducationLevel[]
  targetStandards        String[]
  targetExamGoals        String[]
}

model CategoryTemplate {
  id            String   @id @default(cuid())
  categoryType  ItemType @unique
  cardLayout    String
  visibleFields String[]
  accentColor   String?
  icon          String?
}

model Plan {
  id           String  @id @default(cuid())
  name         String
  description  String
  price        Float
  durationDays Int
  includesAll  Boolean @default(false)
}

model Purchase {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  itemType  ItemType
  itemId    String
  amount    Float
  status    PaymentStatus @default(SUCCESS)
  expiresAt DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, itemType, itemId])
}

model AccessGrant {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  itemType  ItemType
  itemId    String
  grantedBy String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, itemType, itemId])
}

model Exam {
  id                     String           @id @default(cuid())
  title                  String
  subjectId              String?
  subject                Subject?         @relation(fields: [subjectId], references: [id])
  rawPaperFileUrl        String
  durationMinutes        Int
  totalQuestions         Int
  marksPerQuestion       Float
  negativeMarking        Float            @default(0)
  optionsCount           Int              @default(4)
  price                  Float
  isFree                 Boolean          @default(false)
  isPublished            Boolean          @default(false)
  questions              ExamQuestion[]
  attempts               ExamAttempt[]
  createdAt              DateTime         @default(now())
  targetEducationLevels  EducationLevel[]
  targetStandards        String[]
  targetExamGoals        String[]
  accessModel            AccessModel      @default(PAID)
  trialDurationDays      Int?
}

model ExamQuestion {
  id            String @id @default(cuid())
  examId        String
  exam          Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionNo    Int
  correctOption String
  topic         String?

  @@unique([examId, questionNo])
}

model ExamAttempt {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  examId       String
  exam         Exam          @relation(fields: [examId], references: [id])
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  score        Float?
  correctCount Int?
  wrongCount   Int?
  unattempted  Int?
  status       AttemptStatus @default(IN_PROGRESS)
  answers      ExamAnswer[]

  @@index([userId, examId, status])
}

model ExamAnswer {
  id              String      @id @default(cuid())
  attemptId       String
  attempt         ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionNo      Int
  selectedOption  String?
  markedForReview Boolean     @default(false)
  answeredAt      DateTime    @default(now())

  @@unique([attemptId, questionNo])
}

model AuditLog {
  id           String    @id @default(cuid())
  actorId      String
  actor        User      @relation("AuditActor", fields: [actorId], references: [id])
  action       String
  itemType     ItemType?
  itemId       String?
  targetUserId String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}
